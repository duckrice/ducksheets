{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DuckSheets",
  "version": "1.1.0",
  "identifier": "com.duckrice.ducksheets",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DuckSheets",
        "create": false,
        "width": 1280,
        "height": 860,
        "minWidth": 720,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://github.com https://objects.githubusercontent.com",
      "devCsp": "default-src * 'unsafe-inline' 'unsafe-eval' data: blob: ipc: ws: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["xlsx"],
        "name": "Excel Workbook",
        "description": "Excel Workbook",
        "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        "role": "Editor"
      },
      {
        "ext": ["xlsm"],
        "name": "Excel Macro-Enabled Workbook",
        "description": "Excel Macro-Enabled Workbook",
        "mimeType": "application/vnd.ms-excel.sheet.macroEnabled.12",
        "role": "Editor"
      },
      {
        "ext": ["csv"],
        "name": "CSV File",
        "description": "Comma-separated values",
        "mimeType": "text/csv",
        "role": "Editor"
      }
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkxQ0RDMDcwQjExMkVFOEEKUldTSzdoS3hjTUROa1JUcHBWV3ZNWUlLeEpRN2ZlUXJlUUpJeXJMZ3Q4T3RMalRWdlBTSHRPQk0K",
      "endpoints": ["https://github.com/duckrice/ducksheets/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
